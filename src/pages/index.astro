---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Welcome to Astro + Tina CMS"
  description="A modern static marketing site built with Astro and Tina CMS"
>
  <div class="container">
    <section style="padding: 4rem 0; text-align: center;">
      <h1>Welcome to Your New Site</h1>
      <p style="font-size: 1.25rem; margin-bottom: 2rem;">
        Built with Astro and Tina CMS
      </p>
      <p>
        This is a placeholder homepage. Start building your marketing site by
        adding components and pages.
      </p>
    </section>
  </div>
</PageLayout>
