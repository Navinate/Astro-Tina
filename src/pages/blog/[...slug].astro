---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

// Generate static paths for all blog posts
export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

// Format date
const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PageLayout
  title={post.data.title}
  description={post.data.excerpt}
  ogImage={post.data.featured_image}
>
  <article class="blog-post">
    <div class="container">
      <header class="blog-post__header">
        <a href="/blog" class="blog-post__back">← Back to Blog</a>

        <h1 class="blog-post__title">{post.data.title}</h1>

        <div class="blog-post__meta">
          <time datetime={post.data.date} class="blog-post__date">
            {formattedDate}
          </time>
          <span class="blog-post__separator">•</span>
          <span class="blog-post__author">{post.data.author}</span>
        </div>

        {
          post.data.tags && post.data.tags.length > 0 && (
            <div class="blog-post__tags">
              {post.data.tags.map((tag) => (
                <span class="blog-post__tag">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      {
        post.data.featured_image && (
          <div class="blog-post__featured-image">
            <img
              src={post.data.featured_image}
              alt={post.data.title}
              loading="eager"
            />
          </div>
        )
      }

      <div class="blog-post__content prose">
        <Content />
      </div>

      <footer class="blog-post__footer">
        <a href="/blog" class="blog-post__back-link">← Back to all posts</a>
      </footer>
    </div>
  </article>
</PageLayout>

<style>
  .blog-post {
    padding: var(--space-3xl) 0;
  }

  .blog-post__header {
    max-width: 800px;
    margin: 0 auto var(--space-3xl);
  }

  .blog-post__back {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: none;
    margin-bottom: var(--space-lg);
    font-weight: 500;
    transition: color var(--transition-speed);
  }

  .blog-post__back:hover {
    color: var(--color-secondary);
    text-decoration: none;
  }

  .blog-post__title {
    font-size: var(--text-5xl);
    line-height: 1.1;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-base);
    color: #6b7280;
    margin-bottom: var(--space-lg);
  }

  .blog-post__separator {
    color: var(--color-border);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .blog-post__tag {
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--border-radius) / 2);
    color: var(--color-text);
  }

  .blog-post__featured-image {
    max-width: 1000px;
    margin: 0 auto var(--space-3xl);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .blog-post__featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .blog-post__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .blog-post__footer {
    max-width: 800px;
    margin: var(--space-3xl) auto 0;
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }

  .blog-post__back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-speed);
  }

  .blog-post__back-link:hover {
    color: var(--color-secondary);
    text-decoration: none;
  }

  /* Prose styles for markdown content */
  .prose {
    color: var(--color-text);
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-size: var(--text-3xl);
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-lg);
  }

  .prose :global(h3) {
    font-size: var(--text-2xl);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }

  .prose :global(h4) {
    font-size: var(--text-xl);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .prose :global(p) {
    margin-bottom: var(--space-lg);
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .prose :global(a:hover) {
    color: var(--color-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
  }

  .prose :global(li) {
    margin-bottom: var(--space-sm);
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-lg);
    margin: var(--space-xl) 0;
    font-style: italic;
    color: #4b5563;
  }

  .prose :global(pre) {
    background: #1f2937;
    color: #f9fafb;
    padding: var(--space-lg);
    border-radius: var(--border-radius);
    overflow-x: auto;
    margin: var(--space-xl) 0;
  }

  .prose :global(code) {
    background: var(--color-surface);
    padding: 0.2em 0.4em;
    border-radius: calc(var(--border-radius) / 2);
    font-size: 0.9em;
    font-family: var(--font-mono);
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .prose :global(img) {
    border-radius: var(--border-radius);
    margin: var(--space-xl) 0;
  }

  @media (max-width: 768px) {
    .blog-post {
      padding: var(--space-2xl) 0;
    }

    .blog-post__title {
      font-size: var(--text-3xl);
    }

    .blog-post__header {
      margin-bottom: var(--space-2xl);
    }

    .blog-post__featured-image {
      margin-bottom: var(--space-2xl);
    }

    .prose :global(h2) {
      font-size: var(--text-2xl);
      margin-top: var(--space-2xl);
    }

    .prose :global(h3) {
      font-size: var(--text-xl);
      margin-top: var(--space-xl);
    }
  }
</style>
