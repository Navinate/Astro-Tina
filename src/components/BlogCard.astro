---
export interface Props {
  title: string;
  excerpt: string;
  date: string;
  author: string;
  slug: string;
  featuredImage?: string;
  tags?: string[];
}

const { title, excerpt, date, author, slug, featuredImage, tags } = Astro.props;

// Format date
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="blog-card">
  {
    featuredImage && (
      <a href={`/blog/${slug}`} class="blog-card__image-link">
        <img
          src={featuredImage}
          alt={title}
          class="blog-card__image"
          loading="lazy"
        />
      </a>
    )
  }
  <div class="blog-card__content">
    <div class="blog-card__meta">
      <time datetime={date} class="blog-card__date">{formattedDate}</time>
      <span class="blog-card__separator">•</span>
      <span class="blog-card__author">{author}</span>
    </div>
    <h2 class="blog-card__title">
      <a href={`/blog/${slug}`} class="blog-card__title-link">
        {title}
      </a>
    </h2>
    <p class="blog-card__excerpt">{excerpt}</p>
    {
      tags && tags.length > 0 && (
        <div class="blog-card__tags">
          {tags.map((tag) => (
            <span class="blog-card__tag">{tag}</span>
          ))}
        </div>
      )
    }
    <a href={`/blog/${slug}`} class="blog-card__read-more"> Read more → </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: transform var(--transition-speed), box-shadow var(--transition-speed);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .blog-card__image-link {
    display: block;
    overflow: hidden;
  }

  .blog-card__image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform var(--transition-speed);
  }

  .blog-card__image-link:hover .blog-card__image {
    transform: scale(1.05);
  }

  .blog-card__content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: #6b7280;
    margin-bottom: var(--space-md);
  }

  .blog-card__date,
  .blog-card__author {
    margin: 0;
  }

  .blog-card__separator {
    color: var(--color-border);
  }

  .blog-card__title {
    font-size: var(--text-2xl);
    line-height: 1.3;
    margin-bottom: var(--space-md);
  }

  .blog-card__title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-speed);
  }

  .blog-card__title-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .blog-card__excerpt {
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .blog-card__tag {
    font-size: var(--text-xs);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--border-radius) / 2);
    color: var(--color-text);
  }

  .blog-card__read-more {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-speed);
  }

  .blog-card__read-more:hover {
    color: var(--color-secondary);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .blog-card__title {
      font-size: var(--text-xl);
    }
  }
</style>
